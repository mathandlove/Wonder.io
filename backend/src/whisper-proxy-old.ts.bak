import { WebSocket, RawData } from 'ws';
import { z } from 'zod';
import OpenAI from 'openai';
import { createReadStream, unlinkSync, writeFileSync } from 'fs';
import { tmpdir } from 'os';
import { join } from 'path';

/**
 * Normalized STT Event Schema - Vendor-agnostic message format
 * Provides a consistent interface regardless of underlying STT provider
 */
export type NormalizedSttEvent =
  | { type: 'ready' } // Signals that GPT-4o is ready to receive audio
  | { type: 'partial'; text: string }
  | { type: 'final'; text: string; confidence?: number; start?: number; duration?: number }
  | { type: 'error'; code?: string; message: string }
  | { type: 'close' }; // Signals transcription is complete

/**
 * Client control messages - sent from frontend to backend
 */
export type ClientControlMessage =
  | { type: 'start_session' } // Signal start of new recording session (reset accumulation)
  | { type: 'finalize' }; // Request graceful finalization

/**
 * Configuration
 */
const OPENAI_API_KEY = process.env.OPENAI_API_KEY;
const ALLOWED_ORIGIN = process.env.ALLOWED_ORIGIN || 'http://localhost:5173';
const MAX_FRAME_SIZE = 2 * 1024 * 1024; // 2MB per frame
const MAX_TOTAL_BYTES = 50 * 1024 * 1024; // 50MB total per connection
const IDLE_TIMEOUT = 90 * 1000; // 90 seconds (longer for children who pause)
const CHUNK_DURATION_MS = 400; // Process every 400ms for snappier captions (was 1500ms)
const SAMPLE_RATE = 16000; // 16kHz audio
const BYTES_PER_SAMPLE = 2; // 16-bit PCM = 2 bytes per sample
const BYTES_PER_SECOND = SAMPLE_RATE * BYTES_PER_SAMPLE; // 32,000 bytes/sec
const CHUNK_SIZE_BYTES = (CHUNK_DURATION_MS / 1000) * BYTES_PER_SECOND; // ~12.8KB per chunk

/**
 * Initialize OpenAI client
 */
const openai = new OpenAI({
  apiKey: OPENAI_API_KEY,
});

/**
 * Convert PCM buffer to WAV format (required by Whisper)
 */
function pcmToWav(pcmBuffer: Buffer, sampleRate: number): Buffer {
  const numChannels = 1;
  const bitsPerSample = 16;
  const byteRate = sampleRate * numChannels * (bitsPerSample / 8);
  const blockAlign = numChannels * (bitsPerSample / 8);
  const dataSize = pcmBuffer.length;
  const fileSize = 36 + dataSize;

  const wavHeader = Buffer.alloc(44);

  // RIFF chunk descriptor
  wavHeader.write('RIFF', 0);
  wavHeader.writeUInt32LE(fileSize, 4);
  wavHeader.write('WAVE', 8);

  // fmt sub-chunk
  wavHeader.write('fmt ', 12);
  wavHeader.writeUInt32LE(16, 16); // Subchunk1Size (16 for PCM)
  wavHeader.writeUInt16LE(1, 20); // AudioFormat (1 for PCM)
  wavHeader.writeUInt16LE(numChannels, 22);
  wavHeader.writeUInt32LE(sampleRate, 24);
  wavHeader.writeUInt32LE(byteRate, 28);
  wavHeader.writeUInt16LE(blockAlign, 32);
  wavHeader.writeUInt16LE(bitsPerSample, 34);

  // data sub-chunk
  wavHeader.write('data', 36);
  wavHeader.writeUInt32LE(dataSize, 40);

  return Buffer.concat([wavHeader, pcmBuffer]);
}

/**
 * Calculate audio energy (RMS) to detect silence
 */
function calculateAudioEnergy(pcmBuffer: Buffer): number {
  let sum = 0;
  for (let i = 0; i < pcmBuffer.length; i += 2) {
    // Read 16-bit PCM sample (little-endian)
    const sample = pcmBuffer.readInt16LE(i);
    sum += sample * sample;
  }
  const rms = Math.sqrt(sum / (pcmBuffer.length / 2));
  // Normalize to 0-1 range (16-bit audio max is 32768)
  return rms / 32768;
}

/**
 * Transcribe audio chunk using GPT-4o Transcribe
 * @param audioBuffer The audio data to transcribe
 * @param previousContext The accumulated transcript from previous chunks (for context)
 */
async function transcribeChunk(audioBuffer: Buffer, previousContext: string = ''): Promise<string> {
  let tempFilePath: string | null = null;

  try {
    // Check if audio has sufficient energy (not silence)
    const energy = calculateAudioEnergy(audioBuffer);
    const SILENCE_THRESHOLD = 0.0004; // 0.1% of max amplitude (allows quiet speech)

    if (energy < SILENCE_THRESHOLD) {
      console.log(`[GPT-4o] Skipping silent chunk (energy: ${energy.toFixed(4)})`);
      return ''; // Return empty for silence - don't call API
    }

    console.log(`[GPT-4o] Audio energy: ${energy.toFixed(4)} - transcribing...`);

    // Convert PCM to WAV
    const wavBuffer = pcmToWav(audioBuffer, SAMPLE_RATE);

    // Write to temporary file (required for OpenAI SDK in Node.js)
    tempFilePath = join(tmpdir(), `gpt4o_${Date.now()}_${Math.random().toString(36).substr(2, 9)}.wav`);
    writeFileSync(tempFilePath, wavBuffer);

    // Create file stream for OpenAI SDK
    const fileStream = createReadStream(tempFilePath);

    // Build context-aware prompt
    // GPT-4o uses the prompt to understand previous ~30 seconds of speech for better accuracy
    let contextPrompt = 'Transcribe only the speech that is actually present. If there is no speech or only background noise, return nothing.';

    if (previousContext) {
      // Trim context at sentence boundaries for better coherence
      let recentContext = previousContext;

      // Keep last 200 chars max
      if (recentContext.length > 200) {
        recentContext = recentContext.slice(-200);

        // Find the last sentence boundary (period, question mark, exclamation)
        const lastSentenceEnd = Math.max(
          recentContext.lastIndexOf('. '),
          recentContext.lastIndexOf('? '),
          recentContext.lastIndexOf('! ')
        );

        // If found a sentence boundary, trim there for coherent context
        if (lastSentenceEnd > 50) {  // Only if we have at least 50 chars left
          recentContext = recentContext.slice(lastSentenceEnd + 2); // +2 to skip ". "
        }
      }

      contextPrompt = `${recentContext}\n\n${contextPrompt}`;
    }

    // Call GPT-4o Transcribe API with context-aware prompt
    const response = await openai.audio.transcriptions.create({
      file: fileStream as any, // Type cast needed for Node.js fs streams
      model: 'gpt-4o-transcribe',
      language: 'en',
      response_format: 'json',
      prompt: contextPrompt, // Include previous transcription for context
    });

    // Return the transcribed text directly (no filtering)
    return response.text.trim();
  } catch (error) {
    console.error('❌ GPT-4o Transcribe API error:', error);
    throw error;
  } finally {
    // Clean up temporary file
    if (tempFilePath) {
      try {
        unlinkSync(tempFilePath);
      } catch {
        // Ignore cleanup errors
      }
    }
  }
}

/**
 * Handles a single WebSocket connection from the client
 * Uses OpenAI GPT-4o Transcribe for real-time speech-to-text
 */
export function handleWhisperProxy(clientWs: WebSocket, request: any) {
  const requestId = `req_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
  const origin = request.headers.origin || request.headers.referer || 'unknown';

  // Validate origin - support multiple environments
  const allowedOrigins = ALLOWED_ORIGIN.split(',').map(o => o.trim());
  const isAllowed = origin === 'unknown' || allowedOrigins.some(allowed => origin.startsWith(allowed));

  if (!isAllowed) {
    console.warn(`❌ Unauthorized origin attempt: ${origin}`);
    clientWs.send(JSON.stringify({
      type: 'error',
      code: 'UNAUTHORIZED_ORIGIN',
      message: 'Origin not allowed',
    }));
    clientWs.close(1008, 'Unauthorized origin');
    return;
  }

  if (!OPENAI_API_KEY) {
    clientWs.send(JSON.stringify({
      type: 'error',
      code: 'SERVER_CONFIG_ERROR',
      message: 'Server not properly configured',
    }));
    clientWs.close(1011, 'Server configuration error');
    return;
  }

  // Connection state - SIMPLIFIED for single-send approach
  let audioBuffer: Buffer = Buffer.alloc(0); // Buffer ALL audio until finalize
  let totalBytesReceived = 0;
  let idleTimer: NodeJS.Timeout | null = null;
  let isClosed = false;
  let isFinalizing = false;
  let currentSessionId = Date.now(); // Track current session

  /**
   * Cleanup function
   */
  function cleanup(reason: string) {
    if (isClosed) return;
    isClosed = true;

    if (idleTimer) {
      clearTimeout(idleTimer);
      idleTimer = null;
    }

    if (chunkTimer) {
      clearTimeout(chunkTimer);
      chunkTimer = null;
    }

    if (clientWs.readyState === WebSocket.OPEN) {
      clientWs.close(1000, reason);
    }
  }

  /**
   * Reset idle timer
   */
  function resetIdleTimer() {
    if (idleTimer) {
      clearTimeout(idleTimer);
    }

    idleTimer = setTimeout(() => {
      const errorEvent: NormalizedSttEvent = {
        type: 'error',
        code: 'IDLE_TIMEOUT',
        message: 'Connection idle for too long',
      };
      clientWs.send(JSON.stringify(errorEvent));
      cleanup('Idle timeout');
    }, IDLE_TIMEOUT);
  }

  /**
   * Process accumulated audio buffer SEQUENTIALLY
   * This ensures chunks are processed in order with proper context
   */
  async function processAudioBuffer() {
    // If already processing, add current buffer to queue and return
    if (isProcessing) {
      if (audioBuffer.length > 0) {
        processingQueue.push(audioBuffer);
        audioBuffer = Buffer.alloc(0);
        console.log(`[GPT-4o] 📋 Queued chunk (queue size: ${processingQueue.length})`);
      }
      return;
    }

    // If no data in current buffer, check queue
    if (audioBuffer.length === 0) {
      if (processingQueue.length > 0) {
        audioBuffer = processingQueue.shift()!;
        console.log(`[GPT-4o] 📤 Processing queued chunk (${processingQueue.length} remaining)`);
      } else {
        return; // Nothing to process
      }
    }

    if (isClosed) return;

    isProcessing = true;
    const bufferToProcess = audioBuffer;
    const sessionId = currentSessionId; // Capture session ID at start of processing
    audioBuffer = Buffer.alloc(0); // Clear buffer for next chunk

    try {
      console.log(`[GPT-4o] Processing ${bufferToProcess.length} bytes (session: ${sessionId})...`);
      // Pass accumulated context to help GPT-4o understand sentence structure
      const text = await transcribeChunk(bufferToProcess, accumulatedTranscript);

      // Only discard if this is from a PREVIOUS session (different session entirely)
      if (sessionId !== currentSessionId) {
        console.log(`[GPT-4o] ⚠️  Ignoring response from old session ${sessionId} (current: ${currentSessionId})`);
        return; // Discard results from previous recording session only
      }

      if (text && clientWs.readyState === WebSocket.OPEN) {
        // Simply accumulate the new transcribed text
        if (accumulatedTranscript) {
          accumulatedTranscript += ' ' + text;
        } else {
          accumulatedTranscript = text;
        }

        // Send as partial event (real-time update)
        const partialEvent: NormalizedSttEvent = {
          type: 'partial',
          text: accumulatedTranscript,
        };
        clientWs.send(JSON.stringify(partialEvent));

        console.log(`[GPT-4o] ✓ Partial: "${text}" | Full: "${accumulatedTranscript}" (session: ${sessionId})`);
        resetIdleTimer();
      }
    } catch (error) {
      console.error('❌ Transcription error:', error);
      // Don't send error to client for individual chunk failures - just log it
    } finally {
      isProcessing = false;

      // CRITICAL: After finishing, immediately process next queued chunk
      // This ensures sequential processing without gaps
      if (processingQueue.length > 0 && !isClosed) {
        setImmediate(() => processAudioBuffer());
      }
    }
  }

  /**
   * Schedule next chunk processing
   */
  function scheduleChunkProcessing() {
    if (chunkTimer) {
      clearTimeout(chunkTimer);
    }

    chunkTimer = setTimeout(() => {
      processAudioBuffer();
      // Schedule next chunk if still recording
      if (!isFinalizing && !isClosed) {
        scheduleChunkProcessing();
      }
    }, CHUNK_DURATION_MS);
  }

  // Notify client that Whisper is ready
  setTimeout(() => {
    if (clientWs.readyState === WebSocket.OPEN) {
      const readyEvent: NormalizedSttEvent = {
        type: 'ready',
      };
      clientWs.send(JSON.stringify(readyEvent));
      resetIdleTimer();

      // Start chunk processing timer
      scheduleChunkProcessing();
    }
  }, 100);

  /**
   * Handle messages from client (audio data or control messages)
   */
  clientWs.on('message', async (data: RawData) => {
    resetIdleTimer();

    // Check if this is a text message (control command)
    if (typeof data === 'string' || (data instanceof Buffer && data[0] === 0x7b)) { // 0x7b is '{'
      try {
        const message: ClientControlMessage = JSON.parse(data.toString());

        if (message.type === 'start_session') {
          // Reset ALL state for new recording session
          currentSessionId = Date.now(); // Generate new session ID
          accumulatedTranscript = '';
          audioBuffer = Buffer.alloc(0); // Clear any buffered audio from previous session
          processingQueue = []; // Clear any queued chunks from previous session
          console.log(`[GPT-4o] New session started (ID: ${currentSessionId}) - all state reset`);
          return;
        }

        if (message.type === 'finalize') {
          isFinalizing = true;

          // Stop scheduling new chunks
          if (chunkTimer) {
            clearTimeout(chunkTimer);
            chunkTimer = null;
          }

          // Process any remaining audio
          if (audioBuffer.length > 0) {
            await processAudioBuffer();
          }

          // Wait for any in-flight processing to complete
          let attempts = 0;
          while (isProcessing && attempts < 50) { // Max 5 seconds wait
            await new Promise(resolve => setTimeout(resolve, 100));
            attempts++;
          }

          // Send final transcript
          if (clientWs.readyState === WebSocket.OPEN && accumulatedTranscript) {
            const finalEvent: NormalizedSttEvent = {
              type: 'final',
              text: accumulatedTranscript,
            };
            clientWs.send(JSON.stringify(finalEvent));
            console.log(`[GPT-4o] Final: "${accumulatedTranscript}"`);
          }

          // Send close event
          if (clientWs.readyState === WebSocket.OPEN) {
            const closeEvent: NormalizedSttEvent = { type: 'close' };
            clientWs.send(JSON.stringify(closeEvent));
          }

          cleanup('Finalized');
          return;
        }
      } catch {
        // Silently handle parse errors
      }
    }

    // Only accept binary frames (audio data)
    if (!(data instanceof Buffer)) {
      return;
    }

    // Check frame size
    if (data.length > MAX_FRAME_SIZE) {
      const errorEvent: NormalizedSttEvent = {
        type: 'error',
        code: 'FRAME_TOO_LARGE',
        message: `Frame size ${data.length} exceeds limit ${MAX_FRAME_SIZE}`,
      };
      clientWs.send(JSON.stringify(errorEvent));
      cleanup('Frame size exceeded');
      return;
    }

    // Check total bytes
    totalBytesReceived += data.length;
    if (totalBytesReceived > MAX_TOTAL_BYTES) {
      const errorEvent: NormalizedSttEvent = {
        type: 'error',
        code: 'TOTAL_BYTES_EXCEEDED',
        message: `Total bytes ${totalBytesReceived} exceeds limit ${MAX_TOTAL_BYTES}`,
      };
      clientWs.send(JSON.stringify(errorEvent));
      cleanup('Total bytes exceeded');
      return;
    }

    // Accumulate audio data
    audioBuffer = Buffer.concat([audioBuffer, data]);
  });

  /**
   * Handle client disconnect
   */
  clientWs.on('close', () => {
    cleanup('Client disconnected');
  });

  /**
   * Handle client errors
   */
  clientWs.on('error', () => {
    cleanup('Client error');
  });
}
